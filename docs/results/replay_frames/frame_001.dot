graph Frame {
  label="Considering edge (Database-Server - Web-Server), cost=600\nStep 1";
  labelloc="t";
  node [shape=box, style="filled,rounded", fillcolor="#ECEFF1", fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=10];

  1 [label="Core-Router"];
  2 [label="Switch-Floor1"];
  3 [label="Switch-Floor2"];
  4 [label="Database-Server"];
  5 [label="Web-Server"];
  6 [label="Backup-Storage"];

  1 -- 2 [label="1200", color="#CFD8DC", style="dotted"];
  1 -- 3 [label="1500", color="#CFD8DC", style="dotted"];
  2 -- 3 [label="800", color="#CFD8DC", style="dotted"];
  2 -- 4 [label="2200", color="#CFD8DC", style="dotted"];
  2 -- 5 [label="1800", color="#CFD8DC", style="dotted"];
  3 -- 5 [label="2100", color="#CFD8DC", style="dotted"];
  3 -- 6 [label="2700", color="#CFD8DC", style="dotted"];
  4 -- 5 [label="600", color="#F57C00", penwidth=2.5];
  5 -- 6 [label="900", color="#CFD8DC", style="dotted"];
}
