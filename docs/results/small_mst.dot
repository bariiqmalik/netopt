graph MST {
  label="Minimum Spanning Tree\nTotal Cost: 5300";
  labelloc="t";
  node [shape=box, style="filled,rounded", fillcolor="#E8F5E9", fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=10];

  1 [label="Core-Router"];
  2 [label="Switch-Floor1"];
  3 [label="Switch-Floor2"];
  4 [label="Database-Server"];
  5 [label="Web-Server"];
  6 [label="Backup-Storage"];

  1 -- 2 [label="1200", color="#2E7D32", penwidth=2.5];
  1 -- 3 [label="1500", color="#CFD8DC", style="dashed"];
  2 -- 3 [label="800", color="#2E7D32", penwidth=2.5];
  2 -- 4 [label="2200", color="#CFD8DC", style="dashed"];
  2 -- 5 [label="1800", color="#2E7D32", penwidth=2.5];
  3 -- 5 [label="2100", color="#CFD8DC", style="dashed"];
  3 -- 6 [label="2700", color="#CFD8DC", style="dashed"];
  4 -- 5 [label="600", color="#2E7D32", penwidth=2.5];
  5 -- 6 [label="900", color="#2E7D32", penwidth=2.5];
}
